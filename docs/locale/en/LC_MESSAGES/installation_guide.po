msgid "您可以使用npu-smi命令查看系统上的NPU型号。例如，在npu-smi info命令的输出中，\"910B4\" 对应芯片类型A2（昇腾910b系列）："
msgstr "You can use the `npu-smi` command to view the NPU model on your system. For example, in the output of the `npu-smi info` command, \"910B4\" corresponds to chip type A2 (Ascend 910B series)."

msgid "root@localhost:/# npu-smi  info\\n"
msgstr "root@localhost:/# npu-smi info"
