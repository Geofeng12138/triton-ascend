#: ../zh/programming_guide/index.md:147
msgid "@triton.jit\n"
"def pick_kernel(\n"
"        x_ptr,\n"
"        idx_ptr,\n"
"        y_ptr,\n"
"        stride_x,\n"
"        stride_idx,\n"
"        stride_y,\n"
"        M: tl.constexpr,\n"
"        N: tl.constexpr\n"
"):\n"
"    pid = tl.program_id(0)\n"
"    rn = tl.arange(0, N)\n"
"\n"
"    idx = tl.load(idx_ptr + rn * stride_idx)\n"
"    mask = idx < M\n"
"\n"
"    # Original approach\n"
"    # val = tl.load(x_ptr + idx * stride_x, mask=mask)\n"
"    # Revised approach\n"
"    rm = tl.arange(0, M)\n"
"    x_shared = tl.load(x_ptr + rm * stride_x)  # [M]\n"
"    val = tl.gather(x_shared, idx, 0)\n"
"\n"
"    tl.store(y_ptr + rn * stride_y, val, mask=mask)\n"
""
