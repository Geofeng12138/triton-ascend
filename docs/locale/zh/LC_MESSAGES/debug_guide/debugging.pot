msgstr ""

#: ../zh/debug_guide/debugging.md:313
msgid "1.在 Triton kernel 中，为需要调试的常量参数添加 tl.static_print 语句"
msgstr ""

#: ../zh/debug_guide/debugging.md:315
msgid "import triton.language as tl\n"
"\n"
"@triton.jit\n"
"def triton_kernel(\n"
"    out_ptr0,\n"
"    in_ptr0,\n"
"    in_ptr1,\n"
"    XBLOCK: tl.constexpr,  # Compile-time constant parameter\n"
"    USE_FP16: tl.constexpr  # Compile-time constant parameter\n"
"):\n"
"    # Print compile-time constant parameters\n"
"    tl.static_print(\"XBLOCK = \", XBLOCK)\n"
"    tl.static_print(\"USE_FP16 = \", USE_FP16)\n"
"\n"
"    idx = tl.arange(0, XBLOCK)\n"
"    tmp0 = tl.load(in_ptr0 + idx)\n"
"    tmp1 = tl.load(in_ptr1 + idx)\n"
"\n"
"    # Print the constant calculation result\n"
"    elements_per_thread = XBLOCK // 32\n"
"    tl.static_print(\"Elements per thread = \", elements_per_thread)\n"
"\n"
"    tmp2 = tmp0 + tmp1\n"
"    tl.store(out_ptr0 + idx, tmp2)\n"
""
msgstr ""

#: ../zh/debug_guide/debugging.md:342
msgid "2.设置环境变量并运行程序进行编译"
msgstr ""

#: ../zh/debug_guide/debugging.md:344
msgid "# Enable Triton debug output (includes static_print)\n"
