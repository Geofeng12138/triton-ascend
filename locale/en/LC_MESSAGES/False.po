msgstr "The index value in index must be within the range `[0, src_shape[dim])`."

msgid "N/A"
msgstr "N/A"

msgid "**说明：**"
msgstr "**Note:**"

msgid "index 的数据类型必须为 int32 或 int64"
msgstr "The data type of index must be int32 or int64."

msgid "GPU 平台不支持此操作（Ascend 专用 intrinsic）"
msgstr "The GPU platform does not support this operation (Ascend-specific intrinsic)."

