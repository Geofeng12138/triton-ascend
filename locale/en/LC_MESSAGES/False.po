msgstr "`gridY`"

msgid "启动网格 Y 维度"
msgstr "Start grid Y dimension"

msgid "`gridZ`"
msgstr "`gridZ`"

msgid "启动网格 Z 维度"
msgstr "Start grid Z dimension"

