msgstr "1D indexed array, located on UB, specifying the index positions to read."

msgid "src_shape"
msgstr "src_shape"

msgid "Tuple[int]"
msgstr "Tuple[int]"

msgid "源张量的完整形状"
msgstr "The complete shape of the source tensor"

