msgid "Libdevice 开发者手册"
msgstr "Libdevice Developer Manual"

msgid "SIMT 编译示例"
msgstr "SIMT Compilation Example"

msgid "使用 SIMT 编译的 triton kernel 示例"
msgstr "Example of a triton kernel compiled using SIMT"

msgid "1. triton.language.extra.cann.libdevice.abs"
msgstr "1. triton.language.extra.cann.libdevice.abs"

msgid "OP概述"
msgstr "OP Overview"

msgid "计算输入参数的绝对值。"
msgstr "Compute the absolute value of the input argument."

msgid "原型:"
msgstr "Prototype:"

msgid "输入类型："
msgstr "Input type:"

msgid "x: `int32`, `float32`"
msgstr "x: `int32`, `float32`"

msgid "返回值: `tl.tensor`, 返回输入参数的绝对值。"
msgstr "Return value: `tl.tensor`, returns the absolute value of the input parameter."

msgid "返回类型：`int32`, `float32`"
msgstr "Return type: `int32`, `float32`"

msgid "支持编译模式：SIMT"
msgstr "Supported compilation mode: SIMT"

msgid "2. triton.language.extra.cann.libdevice.acos"
msgstr "2. triton.language.extra.cann.libdevice.acos"

msgid "计算输入参数的反余弦值。"
msgstr "Compute the arccosine of the input parameter."

msgid "x: `float32`"
msgstr "x: `float32`"

msgid "返回值: `tl.tensor`, 返回输入参数的反余弦值，取值范围 \\[0, π] 弧度。"
msgstr "Return value: `tl.tensor`, returns the arccosine of the input parameter, with a value range of \\[0, π] radians."

msgid "返回类型：`float32`"
msgstr "Return type: `float32`"

msgid "支持编译模式：SIMT, SIMD"
msgstr "Supported compilation modes: SIMT, SIMD"

msgid "3. triton.language.extra.cann.libdevice.acosh"
msgstr "3. triton.language.extra.cann.libdevice.acosh"

msgid "计算输入参数的反双曲余弦值。"
msgstr "Computes the inverse hyperbolic cosine of the input parameter."

msgid "返回值: `tl.tensor`, 返回输入参数的反双曲余弦值，取值范围 \\[0, +∞]。"
msgstr "Return value: `tl.tensor`, returns the inverse hyperbolic cosine of the input parameter, with a value range of \\[0, +∞]."

msgid "4. triton.language.extra.cann.libdevice.add_rd"
msgstr "4. triton.language.extra.cann.libdevice.add_rd"

msgid "向下舍入浮点数加法。"
msgstr "Round down floating-point addition."

msgid "y: `float32`"
msgstr "y: `float32`"

msgid "返回值: `tl.tensor`, 返回向下舍入的加法结果。"
msgstr "Return value: `tl.tensor`, returns the result of rounding down the addition."

msgid "5. triton.language.extra.cann.libdevice.add_rn"
msgstr "5. triton.language.extra.cann.libdevice.add_rn"

msgid "最近偶数舍入浮点数加法。"
msgstr "Nearest even rounding floating-point addition."

msgid "返回值: `tl.tensor`, 返回最近偶数舍入的加法结果。"
msgstr "Return value: `tl.tensor`, returns the result of addition rounded to the nearest even number."

msgid "6. triton.language.extra.cann.libdevice.add_ru"
msgstr "6. triton.language.extra.cann.libdevice.add_ru"

msgid "向上舍入浮点数加法。"
msgstr "Round up floating-point addition."

msgid "返回值: `tl.tensor`, 返回向上舍入的加法结果。"
msgstr "Return value: `tl.tensor`, returns the result of rounding up the addition."

msgid "7. triton.language.extra.cann.libdevice.add_rz"
msgstr "7. triton.language.extra.cann.libdevice.add_rz"

msgid "向零舍入浮点数加法。"
msgstr "Round floating-point addition towards zero."

msgid "返回值: `tl.tensor`, 返回向零舍入的加法结果。"
msgstr "Return value: `tl.tensor`, returns the result of addition rounded toward zero."

msgid "8. triton.language.extra.cann.libdevice.asin"
msgstr "8. triton.language.extra.cann.libdevice.asin"

msgid "计算输入参数的反正弦值。"
msgstr "Compute the arcsine of the input parameter."

msgid "返回值: `tl.tensor`, 返回输入参数的反正弦值，取值范围 \\[-π/2, π/2] 弧度。"
msgstr "Return value: `tl.tensor`, returns the arcsine of the input parameter, with a value range of \\[-π/2, π/2] radians."

msgid "9. triton.language.extra.cann.libdevice.asinh"
msgstr "9. triton.language.extra.cann.libdevice.asinh"

msgid "计算输入参数的反双曲正弦值。"
msgstr "Compute the inverse hyperbolic sine of the input parameter."

msgid "返回值: `tl.tensor`, 返回输入参数的反双曲正弦值。"
msgstr "Return value: `tl.tensor`, returns the inverse hyperbolic sine of the input parameter."

msgid "10. triton.language.extra.cann.libdevice.atan"
msgstr "10. triton.language.extra.cann.libdevice.atan"

msgid "计算输入参数的反正切值。"
msgstr "Compute the arctangent of the input argument."

msgid "返回值: `tl.tensor`, 返回输入参数的反正切值，取值范围 \\[-π/2, π/2] 弧度。"
msgstr "Return value: `tl.tensor`, returns the arctangent of the input parameter, with a value range of \\[-π/2, π/2] radians."

msgid "11. triton.language.extra.cann.libdevice.atan2"
msgstr "11. triton.language.extra.cann.libdevice.atan2"

msgid "反正切函数，计算 x / y 的反正切值。"
msgstr "Arc tangent function, computes the arctangent of x / y."

msgid "返回值: `tl.tensor`, 返回 x / y 的反正切值，取值范围 \\[-π, π] 弧度。"
msgstr "Return value: `tl.tensor`, returns the arctangent of x / y, with a range of \\[-π, π] radians."

msgid "12. triton.language.extra.cann.libdevice.atanh"
msgstr "12. triton.language.extra.cann.libdevice.atanh"

msgid "反双曲正切函数，计算输入参数的反双曲正切值。"
msgstr "Inverse hyperbolic tangent function, computes the inverse hyperbolic tangent of the input parameter."

msgid "返回值: `tl.tensor`, 返回输入参数的反双曲正切值，取值范围 \\[-1, 1]。"
msgstr "Return value: `tl.tensor`, returns the inverse hyperbolic tangent of the input parameter, with a value range of \\[-1, 1]."

msgid "13. triton.language.extra.cann.libdevice.brev"
msgstr "13. triton.language.extra.cann.libdevice.brev"

msgid "位反转函数，反转32位整数的位顺序。"
msgstr "Bit-reversal function, reverses the bit order of a 32-bit integer."

msgid "x: `int32`"
msgstr "x: `int32`"

msgid "返回值: `tl.tensor`, 返回位反转后的32位整数。"
msgstr "Return value: `tl.tensor`, returns the 32-bit integer after bit-reversal."

msgid "返回类型：`int32`"
msgstr "Return type: `int32`"

msgid "14. triton.language.extra.cann.libdevice.byte_perm"
msgstr "14. triton.language.extra.cann.libdevice.byte_perm"

msgid "字节排列操作，从两个32位整数中选择字节组成新整数。输入整数 x 和 y 的字节顺序如下。"
msgstr "Byte permutation operation, selects bytes from two 32-bit integers to form a new integer. The byte order of input integers x and y is as follows."

msgid "字节选择参数 s 为32位整数，各比特位与字节选择对应关系如下。"
msgstr "The byte selection parameter s is a 32-bit integer, and the correspondence between each bit and byte selection is as follows."

msgid "y: `int32`"
msgstr "y: `int32`"

msgid "s: `int32`"
msgstr "s: `int32`"

msgid "返回值: `tl.tensor`, 返回值 return\\[n] := input\\[selector\\[n]]，n 表示输出整数的第 n 个字节。"
msgstr "Return value: `tl.tensor`, return value return[n] := input[selector[n]], where n denotes the nth byte of the output integer."

msgid "15. triton.language.extra.cann.libdevice.cbrt"
msgstr "15. triton.language.extra.cann.libdevice.cbrt"

msgid "计算输入参数的立方根值。"
msgstr "Compute the cube root of the input argument."

msgid "返回值: `tl.tensor`, 返回输入参数的立方根值。"
msgstr "Return value: `tl.tensor`, returns the cube root of the input parameter."

msgid "16. triton.language.extra.cann.libdevice.ceil"
msgstr "16. triton.language.extra.cann.libdevice.ceil"

msgid "向上取整，返回大于或等于 x 的最小整数。"
msgstr "Round up, returning the smallest integer greater than or equal to x."

msgid "返回值: `tl.tensor`, 返回向上取整的结果。"
msgstr "Return value: `tl.tensor`, returns the result of rounding up."

msgid "17. triton.language.extra.cann.libdevice.clz"
msgstr "17. triton.language.extra.cann.libdevice.clz"

msgid "计算32位整数的前导零数量。"
msgstr "Counts the number of leading zeros in a 32-bit integer."

msgid "返回值: `tl.tensor`, 返回输入参数的前导零数量。范围 \\[0, 32]。"
msgstr "Return value: `tl.tensor`, returns the number of leading zeros of the input parameter. Range [0, 32]."

msgid "18. triton.language.extra.cann.libdevice.copysign"
msgstr "18. triton.language.extra.cann.libdevice.copysign"

msgid "生成一个浮点数，其绝对值等于 x 的绝对值，符号与 y 相同。"
msgstr "Generate a floating-point number whose absolute value equals the absolute value of x and whose sign matches that of y."

msgid "返回值: `tl.tensor`, 返回一个浮点数，其绝对值等于 x 的绝对值，符号与 y 相同。"
msgstr "Return value: `tl.tensor`, returns a floating-point number whose absolute value equals the absolute value of x, with the same sign as y."

msgid "19. triton.language.extra.cann.libdevice.cos"
msgstr "19. triton.language.extra.cann.libdevice.cos"

msgid "计算输入参数（弧度）的余弦值。"
msgstr "Compute the cosine of the input parameter (in radians)."

msgid "返回值: `tl.tensor`, 返回输入参数的余弦值。"
msgstr "Return value: `tl.tensor`, returns the cosine of the input parameter."

msgid "20. triton.language.extra.cann.libdevice.cosh"
msgstr "20. triton.language.extra.cann.libdevice.cosh"

msgid "计算输入参数的双曲余弦值。"
msgstr "Compute the hyperbolic cosine of the input parameter."

msgid "返回值: `tl.tensor`, 返回输入参数的双曲余弦值。"
msgstr "Return value: `tl.tensor`, returns the hyperbolic cosine of the input parameter."

msgid "21. triton.language.extra.cann.libdevice.cospi"
msgstr "21. triton.language.extra.cann.libdevice.cospi"

msgid "计算 cos(π × x) 的值。"
msgstr "Compute the value of cos(π × x)."

msgid "返回值: `tl.tensor`, 返回 cos(π × x) 的值。"
msgstr "Return value: `tl.tensor`, returns the value of cos(π × x)."

msgid "22. triton.language.extra.cann.libdevice.cyl_bessel_i0"
msgstr "22. triton.language.extra.cann.libdevice.cyl_bessel_i0"

msgid "计算输入参数的修正零阶贝塞尔函数值。"
msgstr "Compute the modified Bessel function of the first kind of order zero for the input argument."

msgid "返回值: `tl.tensor`, 返回输入参数的修正零阶贝塞尔函数值。"
msgstr "Return value: `tl.tensor`, returns the modified zero-order Bessel function value of the input parameter."

msgid "23. triton.language.extra.cann.libdevice.cyl_bessel_i1"
msgstr "23. triton.language.extra.cann.libdevice.cyl_bessel_i1"

msgid "计算输入参数的修正一阶贝塞尔函数值。"
msgstr "Compute the modified Bessel function of the first kind of order one for the input argument."

msgid "返回值: `tl.tensor`, 返回输入参数的修正一阶贝塞尔函数值。"
msgstr "Return value: `tl.tensor`, returns the modified Bessel function of the first kind of the input parameter."

msgid "24. triton.language.extra.cann.libdevice.div_rd"
msgstr "24. triton.language.extra.cann.libdevice.div_rd"

msgid "向下舍入浮点数除法。"
msgstr "Round down floating-point division."

msgid "返回值: `tl.tensor`, 返回除法结果。"
msgstr "Return value: `tl.tensor`, returns the result of division."

msgid "25. triton.language.extra.cann.libdevice.div_rn"
msgstr "25. triton.language.extra.cann.libdevice.div_rn"

msgid "最近偶数舍入浮点数除法。"
msgstr "Nearest even rounding floating-point division."

msgid "26. triton.language.extra.cann.libdevice.div_ru"
msgstr "26. triton.language.extra.cann.libdevice.div_ru"

msgid "向上舍入浮点数除法。"
msgstr "Round up floating-point division."

msgid "27. triton.language.extra.cann.libdevice.div_rz"
msgstr "27. triton.language.extra.cann.libdevice.div_rz"

msgid "向零舍入浮点数除法。"
msgstr "Floating-point division rounding toward zero."

msgid "28. triton.language.extra.cann.libdevice.erf"
msgstr "28. triton.language.extra.cann.libdevice.erf"

msgid "计算输入参数的误差函数值。"
msgstr "Compute the error function value of the input argument."

msgid "返回值: `tl.tensor`, 返回输入参数的误差函数值。"
msgstr "Return value: `tl.tensor`, returns the error function value of the input parameter."

msgid "29. triton.language.extra.cann.libdevice.erfc"
msgstr "29. triton.language.extra.cann.libdevice.erfc"

msgid "计算输入参数的互补误差函数值，即 1 - erf(x)。"
msgstr "Compute the complementary error function value of the input parameter, i.e., 1 - erf(x)."

msgid "返回值: `tl.tensor`, 返回输入参数的互补误差函数值。"
msgstr "Return value: `tl.tensor`, returns the complementary error function value of the input parameter."

msgid "30. triton.language.extra.cann.libdevice.erfcinv"
msgstr "30. triton.language.extra.cann.libdevice.erfcinv"

msgid "逆互补误差函数，找到满足 x = erfc(y) 的值 y。"
msgstr "Inverse complementary error function, find the value y that satisfies x = erfc(y)."

msgid "返回值: `tl.tensor`, 返回输入参数的逆互补误差函数值。"
msgstr "Return value: `tl.tensor`, returns the inverse complementary error function value of the input parameter."

msgid "31. triton.language.extra.cann.libdevice.erfcx"
msgstr "31. triton.language.extra.cann.libdevice.erfcx"

msgid "计算输入参数的缩放互补误差函数值，即 exp(x²) × erfc(x)。"
msgstr "Compute the scaled complementary error function value of the input argument, i.e., exp(x²) × erfc(x)."

msgid "返回值: `tl.tensor`, 返回输入参数的缩放互补误差函数值。"
msgstr "Return value: `tl.tensor`, returns the scaled complementary error function value of the input parameter."

msgid "32. triton.language.extra.cann.libdevice.erfinv"
msgstr "32. triton.language.extra.cann.libdevice.erfinv"

msgid "逆误差函数，找到满足 x = erf(y) 的值 y。"
msgstr "Inverse error function, finds the value y such that x = erf(y)."

msgid "返回值: `tl.tensor`, 返回输入参数的逆误差函数值。"
msgstr "Return value: `tl.tensor`, returns the inverse error function value of the input parameter."

msgid "33. triton.language.extra.cann.libdevice.exp"
msgstr "33. triton.language.extra.cann.libdevice.exp"

msgid "指数函数，计算 e 的 x 次方。"
msgstr "Exponential function, computes e raised to the power of x."

msgid "返回值: `tl.tensor`, 返回 e 的 x 次方的计算结果。"
msgstr "Return value: `tl.tensor`, returns the result of e raised to the power of x."

msgid "34. triton.language.extra.cann.libdevice.exp10"
msgstr "34. triton.language.extra.cann.libdevice.exp10"

msgid "以 10 为底的指数函数，计算 10 的 x 次方。"
msgstr "Base-10 exponential function, computes 10 raised to the power of x."

msgid "返回值: `tl.tensor`, 返回 10 的 x 次方的计算结果。"
msgstr "Return value: `tl.tensor`, returns the result of 10 raised to the power of x."

msgid "35. triton.language.extra.cann.libdevice.exp2"
msgstr "35. triton.language.extra.cann.libdevice.exp2"

msgid "以 2 为底的指数函数，计算 2 的 x 次方。"
msgstr "Base-2 exponential function, computes 2 raised to the power of x."

msgid "返回值: `tl.tensor`, 返回 2 的 x 次方的计算结果。"
msgstr "Return value: `tl.tensor`, returns the result of 2 raised to the power of x."

msgid "36. triton.language.extra.cann.libdevice.expm1"
msgstr "36. triton.language.extra.cann.libdevice.expm1"

msgid "计算 e 的 x 次方减 1 的结果。"
msgstr "Compute the result of e raised to the power of x minus 1."

msgid "返回值: `tl.tensor`, 返回 e 的 x 次方减 1 的计算结果。"
msgstr "Return value: `tl.tensor`, returns the result of e raised to the power of x minus 1."

msgid "37. triton.language.extra.cann.libdevice.fast_cosf"
msgstr "37. triton.language.extra.cann.libdevice.fast_cosf"

msgid "快速近似余弦函数。"
msgstr "Fast approximate cosine function."

msgid "返回值: `tl.tensor`, 返回快速近似余弦函数的结果。"
msgstr "Return value: `tl.tensor`, returns the result of the fast approximate cosine function."

msgid "38. triton.language.extra.cann.libdevice.fast_dividef"
msgstr "38. triton.language.extra.cann.libdevice.fast_dividef"

msgid "快速近似除法。"
msgstr "Fast approximate division."

msgid "返回值: `tl.tensor`, 返回快速近似除法的结果。"
msgstr "Return value: `tl.tensor`, returns the result of fast approximate division."

msgid "39. triton.language.extra.cann.libdevice.fast_exp10f"
msgstr "39. triton.language.extra.cann.libdevice.fast_exp10f"

msgid "快速近似以 10 为底的指数函数。"
msgstr "Fast approximation of the base-10 exponential function."

msgid "返回值: `tl.tensor`, 返回快速近似以 10 为底的指数函数的结果。"
msgstr "Return value: `tl.tensor`, returns the result of a fast approximation of the base-10 exponential function."

msgid "40. triton.language.extra.cann.libdevice.fast_expf"
msgstr "40. triton.language.extra.cann.libdevice.fast_expf"

msgid "快速近似指数函数。"
msgstr "Fast approximate exponential function."

msgid "返回值: `tl.tensor`, 返回快速近似指数函数的结果。"
msgstr "Return value: `tl.tensor`, returns the result of the fast approximate exponential function."

msgid "41. triton.language.extra.cann.libdevice.fast_log10f"
msgstr "41. triton.language.extra.cann.libdevice.fast_log10f"

msgid "快速近似以 10 为底的对数函数。"
msgstr "Fast approximate base-10 logarithm function."

msgid "返回值: `tl.tensor`, 返回快速近似以 10 为底的对数函数的结果。"
msgstr "Return value: `tl.tensor`, returns the result of a fast approximation of the base-10 logarithm function."

msgid "42. triton.language.extra.cann.libdevice.fast_log2f"
msgstr "42. triton.language.extra.cann.libdevice.fast_log2f"

msgid "快速近似以 2 为底的对数函数。"
msgstr "Fast approximate base-2 logarithm function."

msgid "返回值: `tl.tensor`, 返回快速近似以 2 为底的对数函数的结果。"
msgstr "Return value: `tl.tensor`, returns the result of a fast approximate base-2 logarithm function."

msgid "43. triton.language.extra.cann.libdevice.fast_logf"
msgstr "43. triton.language.extra.cann.libdevice.fast_logf"

msgid "快速近似自然对数函数。"
msgstr "Fast approximate natural logarithm function."

msgid "返回值: `tl.tensor`, 返回快速近似自然对数函数的结果。"
msgstr "Return value: `tl.tensor`, returns the result of the fast approximate natural logarithm function."

msgid "44. triton.language.extra.cann.libdevice.fast_powf"
msgstr "44. triton.language.extra.cann.libdevice.fast_powf"

msgid "快速近似幂函数。"
msgstr "Fast approximate power function."

msgid "返回值: `tl.tensor`, 返回快速近似幂函数的结果。"
msgstr "Return value: `tl.tensor`, returns the result of the fast approximate power function."

msgid "45. triton.language.extra.cann.libdevice.fast_sinf"
msgstr "45. triton.language.extra.cann.libdevice.fast_sinf"

msgid "快速近似正弦函数。"
msgstr "Fast approximate sine function."

msgid "返回值: `tl.tensor`, 返回快速近似正弦函数的结果。"
msgstr "Return value: `tl.tensor`, returns the result of the fast approximate sine function."

msgid "46. triton.language.extra.cann.libdevice.fast_tanf"
msgstr "46. triton.language.extra.cann.libdevice.fast_tanf"

msgid "快速近似正切函数。"
msgstr "Fast approximate tangent function."

msgid "返回值: `tl.tensor`, 返回快速近似正切函数的结果。"
msgstr "Return value: `tl.tensor`, returns the result of the fast approximate tangent function."

msgid "47. triton.language.extra.cann.libdevice.fdim"
msgstr "47. triton.language.extra.cann.libdevice.fdim"

msgid "计算 x 与 y 的正差。当 x > y 时，返回 x - y，否则返回 0。"
msgstr "Compute the positive difference between x and y. Returns x - y when x > y, otherwise returns 0."

msgid "返回值: `tl.tensor`, 返回 x 与 y 之间的正差。"
msgstr "Return value: `tl.tensor`, returns the positive difference between x and y."

msgid "48. triton.language.extra.cann.libdevice.ffs"
msgstr "48. triton.language.extra.cann.libdevice.ffs"

msgid "查找第一个被置为1的位，返回最低被置为1的位的索引。"
msgstr "Find the first bit set to 1, return the index of the lowest bit set to 1."

msgid "返回值: `tl.tensor`, 返回最低被置为1的位的索引，取值范围 \\[0, 32]。"
msgstr "Return value: `tl.tensor`, returns the index of the least significant bit set to 1, with a value range of [0, 32]."

msgid "49. triton.language.extra.cann.libdevice.finitef"
msgstr "49. triton.language.extra.cann.libdevice.finitef"

msgid "判断输入是否为有限浮点数。"
msgstr "Determine whether the input is a finite floating-point number."

msgid "返回值: `tl.tensor`, 若输入为有限值返回 True，否则返回 False。"
msgstr "Return value: `tl.tensor`, returns True if the input is finite, otherwise returns False."

msgid "返回类型：`bool`"
msgstr "Return type: `bool`"

msgid "50. triton.language.extra.cann.libdevice.float2int_rd"
msgstr "50. triton.language.extra.cann.libdevice.float2int_rd"

msgid "向下舍入模式将浮点数转换为32位整数。"
msgstr "Downward rounding mode converts floating-point numbers to 32-bit integers."

msgid "返回值: `tl.tensor`, 返回转换后的32位整数。"
msgstr "Return value: `tl.tensor`, returns the converted 32-bit integer."

msgid "51. triton.language.extra.cann.libdevice.float2int_rn"
msgstr "51. triton.language.extra.cann.libdevice.float2int_rn"

