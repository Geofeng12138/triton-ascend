msgstr "`triton_kernel.py` (Python)"

msgid "`ttir.mlir` (MLIR)"
msgstr "`ttir.mlir` (MLIR)"

msgid "Triton JIT 编译器"
msgstr "Triton JIT Compiler"

msgid "将用户编写的Triton Python kernel编译为标准Triton IR (TTIR)。"
msgstr "Compile the user-written Triton Python kernel into standard Triton IR (TTIR)."

msgid "**Triton IR 适配转换**"
msgstr "**Triton IR Adaptation Conversion**"

msgid "`ttir.mlir`"
msgstr "`ttir.mlir`"

msgid "`ttadapter.mlir`"
msgstr "`ttadapter.mlir`"

msgid "适配Ascend的Triton后端"
msgstr "Triton Backend Adapted for Ascend"

msgid "**关键调试阶段**。将TTIR转换为面向Ascend NPU后端的适配器IR。"
msgstr "**Key Debugging Phase**. Convert TTIR to adapter IR for the Ascend NPU backend."

msgid "**MLIR 编译与代码生成**"
msgstr "**MLIR Compilation and Code Generation**"

msgid "`.o` (可执行对象文件)"
msgstr "`.o` (executable object file)"

