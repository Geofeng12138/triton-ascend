msgstr "`src`"

msgid "要被访问的源张量"
msgstr "The source tensor to be accessed"

msgid "`indice`"
msgstr "`indice`"

msgid "`tuple of ints` 或 `tuple of tensors`"
msgstr "`tuple of ints` or `tuple of tensors`"

msgid "用于指定元素位置的索引"
msgstr "Index used to specify element position"

msgid "返回值： `scalar`：与 `src` 张量元素类型相同的标量值"
msgstr "Return value: `scalar`: a scalar value of the same element type as the `src` tensor."

msgid "支持任意形状的张量，但需满足： `indice` 的长度必须与 `src` 张量的维度数相同。"
msgstr "Supports tensors of arbitrary shape, but must satisfy: the length of `indice` must be equal to the number of dimensions of the `src` tensor."

