msgid "triton.language.sync_block_set"
msgstr "triton.language.sync_block_set"

msgid "显式的核心间同步指令，用于协调 Cube-Vector 架构中不同核心间的执行顺序和数据一致性。"
msgstr "Explicit inter-core synchronization instruction used to coordinate execution order and data consistency among different cores in the Cube-Vector architecture."

msgid "2. `sync_block_set` 操作"
msgstr "2. `sync_block_set` operation"

msgid "2.1 函数概述"
msgstr "2.1 Function Overview"

msgid "生产者核心完成任务后，向消费者发送同步信号。"
msgstr "After the producer core completes its task, it sends a synchronization signal to the consumer."

msgid "2.2 规格"
msgstr "2.2 Specifications"

msgid "2.2.1 参数说明"
msgstr "2.2.1 Parameter Description"

msgid "`sender`"
msgstr "`sender`"

msgid "发送方核心类型：\"cube\" 或 \"vector\""
msgstr "Sender core type: \"cube\" or \"vector\""

msgid "`receiver`"
msgstr "`receiver`"

msgid "接收方核心类型：\"cube\" 或 \"vector\""
msgstr "Receiver core type: \"cube\" or \"vector\""

msgid "`event_id`"
msgstr "`event_id`"

msgid "事件ID，用于区分不同的同步点"
msgstr "Event ID, used to distinguish different synchronization points"

msgid "2.2.2 特殊限制说明"
msgstr "2.2.2 Special Limitations"

msgid "`sender` 和 `receiver` 不能相同，不能自己给自己发信号"
msgstr "`sender` and `receiver` cannot be the same; you cannot send a signal to yourself."

msgid "`event_id` 必须在 0-15 范围内（共16个独立事件）"
msgstr "`event_id` must be in the range 0-15 (16 independent events in total)."

msgid "3. `sync_block_wait` 操作"
msgstr "3. `sync_block_wait` operation"

msgid "3.1 函数概述"
msgstr "3.1 Function Overview"

msgid "消费者核心等待生产者的同步信号。"
msgstr "The consumer core waits for the synchronization signal from the producer."

msgid "3.2 规格"
msgstr "3.2 Specifications"

msgid "3.2.1 参数说明"
msgstr "3.2.1 Parameter Description"

msgid "等待的事件ID"
msgstr "Event ID to wait for"

msgid "3.2.2 特殊限制说明"
msgstr "3.2.2 Special Limitations"

msgid "`sender` 和 `receiver` 不能相同"
msgstr "`sender` and `receiver` cannot be the same."

msgid "`event_id` 必须与对应 `sync_block_set` 使用的 ID 一致"
msgstr "`event_id` must match the ID used by the corresponding `sync_block_set`."

msgid "4. `sync_block_all` 操作"
msgstr "4. `sync_block_all` operation"

msgid "4.1 函数概述"
msgstr "4.1 Function Overview"

msgid "全局屏障同步，让所有指定类型的核心同步到同一点。"
msgstr "Global barrier synchronization, synchronizing all cores of the specified type to the same point."

msgid "4.2 规格"
msgstr "4.2 Specifications"

msgid "4.2.1 参数说明"
msgstr "4.2.1 Parameter Description"

msgid "`mode`"
msgstr "`mode`"

msgid "同步模式：\"all_cube\"、\"all_vector\" 或 \"all\""
msgstr "Synchronization mode: \"all_cube\", \"all_vector\", or \"all\""

msgid "全局同步事件ID"
msgstr "Global Synchronization Event ID"

msgid "4.2.2 特殊限制说明"
msgstr "4.2.2 Special Limitations"

msgid "`mode` 必须为 \"all_cube\"、\"all_vector\" 或 \"all\" 之一"
msgstr "`mode` must be one of \"all_cube\", \"all_vector\", or \"all\"."

msgid "`event_id` 必须在 0-15 范围内"
msgstr "`event_id` must be in the range 0-15."

