msgstr "2.1 Input Parameters"

msgid "sync_mode:指定barrier的类型，为al.SYNC_IN_VF 枚举"
msgstr "sync_mode: specifies the type of barrier, which is the al.SYNC_IN_VF enum"

msgid "3.约束"
msgstr "3. Constraints"

msgid "仅可在scope中使用（目前未拦截）"
msgstr "Can only be used within a scope (currently not blocked)"

